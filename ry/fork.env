#
# Fork build metadata, read by .github/workflows/ry-windows.yml.
# Release tags are "<UPSTREAM_VERSION>-ry.<FORK_REV>" (no leading "v", so
# upstream's CI and CMake's "git describe --match v*" both ignore them).

# upstream commit ry-fixes is based on (must be an ancestor of HEAD)
UPSTREAM_COMMIT=c1b19244a37bd238038ea2bf0ab56d9efc2de5d7
# what upstream calls that commit: git describe of it, v1.27.0-17-g... -> 1.27.0.17
UPSTREAM_VERSION=1.27.0.17
# bump for every fork release on the same base; reset to 1 when rebasing
FORK_REV=1
